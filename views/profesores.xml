<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="escola.profesores_form">
      <field name="name">EscolaProfesores form</field>
      <field name="model">hr.employee</field>
      <field name="inherit_id" ref="hr.view_employee_form"/>
      <field name="arch" type="xml">
      <!-- ací va el xpath -->
        <xpath expr="//page[@name='hr_settings']" position="after">
            <page name="Escuela" string="Escuela">
                <group>
                  <field name="es_professor"/>
                  <field name="clase"/>
                </group>
            </page>
        </xpath>
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="escola.profesores_window">
      <field name="name">Escola Profesores window</field>
      <field name="res_model">hr.employee</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->
