    <!-- <menuitem name="Clases" id="escola.clases_menu_root"/> -->

    <!-- menu categories -->

    <menuitem name="Profesores" id="escola.profesores_menu_1" parent="escola.eventos_menu_root"/>

    <!-- actions -->

    <menuitem name="Profesores" id="escola.profesores_menu_1_list" parent="escola.profesores_menu_1"
              action="escola.profesores_window"/>

  </data>
</odoo>