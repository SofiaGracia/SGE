        }
      </field>
    </record>
-->

    <!-- Top menu item -->

    <!-- <menuitem name="Clases" id="escola.clases_menu_root"/> -->

    <!-- menu categories -->

    <menuitem name="Clases" id="escola.clases_menu_1" parent="escola.eventos_menu_root"/>

    <!-- actions -->

    <menuitem name="Clases" id="escola.clases_menu_1_list" parent="escola.clases_menu_1"
              action="escola.clases_window"/>

  </data>
</odoo>