<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="escola.clases_tree">
      <field name="name">EscolaClases tree</field>
      <field name="model">escola.clases</field>
      <field name="arch" type="xml">
        <tree>
          <field name="curso"/>
          <field name="nivel"/>
          <field name="fecha_inicio"/>
          <field name="fecha_final"/>
          <field name="tutor"/>
          <field name="alumnos"/>
          <field name="total_alumnos"/>
          <field name="descripcion"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="escola.clases_form">
      <field name="name">EscolaClases form</field>
      <field name="model">escola.clases</field>
      <field name="arch" type="xml">
        <form string="Escola Clases Form">
          <sheet>
            <group>
              <field name="curso"/>
              <field name="nivel"/>
              <field name="fecha_inicio"/>
              <field name="fecha_final"/>
              <field name="tutor"/>
              <field name="alumnos"/>
              <field name="descripcion"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="escola.clases_window">
      <field name="name">Escola Clases window</field>
      <field name="res_model">escola.clases</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->
