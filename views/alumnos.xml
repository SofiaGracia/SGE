      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->

    <!--<menuitem name="Alumnos" id="escola.alumnos_menu_root"/>-->

    <!-- menu categories -->

    <menuitem name="Alumnos" id="escola.alumnos_menu_1" parent="escola.eventos_menu_root"/>

    <!-- actions -->

    <menuitem name="Alumnos" id="escola.alumnos_menu_1_list" parent="escola.alumnos_menu_1"
              action="escola.alumnos_window"/>

  </data>
</odoo>