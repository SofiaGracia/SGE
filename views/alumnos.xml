<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="escola.alumnos_tree">
      <field name="name">EscolaAlumnos tree</field>
      <field name="model">escola.alumnos</field>
      <field name="arch" type="xml">
        <tree>
          <!-- <header>
            <button name="%(lanzar_wizard)d" type="action" string="Lanzar wizard" class="oe_highlight" />
          </header> -->
          <field name="nombre"/>
          <field name="apellidos"/>
          <field name="dni"/>
          <field name="fecha_nacimiento"/>
          <field name="edad"/>
          <field name="clase"/>
          <field name="eventos"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="escola.alumnos_form">
      <field name="name">EscolaAlumnos form</field>
      <field name="model">escola.alumnos</field>
      <field name="arch" type="xml">
        <form string="Escola Alumnos Form">
          <sheet>
            <group>
              <field name="nombre"/>
              <field name="apellidos"/>
              <field name="dni"/>
              <field name="fecha_nacimiento"/>
              <field name="clase"/>
              <field name="eventos"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="escola.alumnos_window">
      <field name="name">Escola Alumnos window</field>
      <field name="res_model">escola.alumnos</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="gestio_escola.action_server">
      <field name="name">GestioEscola server</field>
      <field name="model_id" ref="model_gestio_escola_gestio_escola"/>
