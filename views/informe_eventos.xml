<odoo>
    <record id="action_report_escola_eventos" model="ir.actions.report">
        <field name="name">Informe de Eventos</field>
        <field name="model">escola.eventos</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">escola.eventos_report_template</field>
        <field name="report_file">escola.eventos_report_template</field>
        <field name="binding_model_id" ref="model_escola_eventos"/>
        <field name="binding_type">report</field>
    </record>
    <template id="eventos_report_template">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="docs"/>
            <main>
                <div class="page">
                    <t t-foreach="docs" t-as="evento">
                        <h2 style="text-align: center;">Informe de l'Esdeveniment</h2>
                        <p>
                            <strong>Identificador:</strong>
                            <t t-set="identificador" t-value="evento.clase.nivel+' '+evento.clase.curso+' '+dict(evento._fields['tipo'].selection).get(evento.tipo, 'Desconocido') "/>
                            <t t-esc="identificador"/>
                        </p>
                        <p>
                            <strong>Data:</strong>
                            <t t-esc="evento.fecha"/>
                        </p>
                        <p>
                            <strong>Professor assignat:</strong>
                            <t t-esc="evento.clase.tutor.name"/>
                        </p>
                        <p>
                            <strong>Descripció:</strong>
                            <t t-esc="evento.descripcion"/>
                        </p>
                        <h3>Estudiants associats:</h3>
                        <ul>
                            <t t-foreach="evento.alumno" t-as="student">
                                <li>
                                    <t t-esc="student.nombre"/>
                                </li>
                            </t>
                        </ul>
                    </t>
                </div>
            </main>
        </t>
