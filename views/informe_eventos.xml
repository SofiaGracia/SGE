<odoo>
    <record id="action_report_escola_eventos" model="ir.actions.report">
        <field name="name">Informe de Eventos</field>
        <field name="model">escola.eventos</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">escola.eventos_report_template</field>
        <field name="report_file">escola.eventos_report_template</field>
        <field name="binding_model_id" ref="model_escola_eventos"/>
        <field name="binding_type">report</field>
    </record>
    <template id="eventos_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="evento">
                <div class="page">
                    <!-- Evento com a tal no té name -->
                    <!-- <h2>Event: <t t-esc="evento.name"/></h2> -->
                    <p><strong>Identificador:</strong> <t t-esc="dict(evento._fields['tipo'].selection).get(evento.tipo, 'Desconocido')"/></p>
                    <p><strong>Data:</strong> <t t-esc="evento.fecha"/></p>
                    <!-- Evento com a tal no té professor pero classe sí que té tutor -->
                    <p><strong>Professor assignat:</strong> <t t-esc="evento.clase.tutor.name"/></p>
                    <p><strong>Descripció:</strong> <t t-esc="evento.descripcion"/></p>
                    <h3>Estudiants associats:</h3>
                    <ul>
                        <t t-foreach="evento.alumno" t-as="student">
                            <li><t t-esc="student.nombre"/></li>
                        </t>
                    </ul>
                </div>
            </t>
        </t>
    </template>
</odoo>
